# Copy to .env.local for development. This repo holds NO secrets — only public,
# build-time config (all NEXT_PUBLIC_*). Real production values are set in Coolify.

# Base URL of the backend API. Ignored when API mocking is enabled below.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Set to "enabled" to serve the app from MSW mocks instead of the real backend.
# This is what the `client-preview` deploy uses so the AI-editable preview never
# touches real store data (PROJECT_BRIEF.md §10). Leave empty for production.
NEXT_PUBLIC_API_MOCKING=

# Set to "false" to hide the storefront: shop, cart, checkout and order pages
# 404, and the homepage teaser becomes a "coming soon" notice. Production runs
# with the shop off until Stripe and real products exist. Anything else (including
# empty) leaves the shop on, so dev and the preview keep exercising it.
NEXT_PUBLIC_SHOP_ENABLED=
